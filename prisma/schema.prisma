generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== משתמשים / עובדים ====================

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String   @default("")
  role      String   @default("campaignManager") // admin | manager | campaignManager | client
  phone              String   @default("")
  assignedClientIds  String   @default("[]") // JSON array of client IDs
  isActive           Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  managedClients  Client[]          @relation("ClientManager")
  assignedTasks   Task[]            @relation("TaskAssignee")
  createdTasks    Task[]            @relation("TaskCreator")
  taskNotes       TaskNote[]
  leadCalls       LeadCall[]
  chatMessages    ChatMessage[]
  chatReads       ChatMessageRead[]
  chatRooms       ChatParticipant[]
  googleCalendar  GoogleCalendarConnection?
  aiChats         AiChat[]
  aiMessages      AiChatMessage[]

  @@map("users")
}

// ==================== לקוחות ====================

model Client {
  id                String   @id @default(cuid())
  name              String
  manager           String   @default("") // legacy
  campaignManager   String   @default("") // שם מנהל קמפיינים
  campaignManagerId String?
  accountManager    String   @default("") // שם מנהל תיקים/סמנכ״ל
  accountManagerId  String?
  platforms         String   @default("[]") // JSON array
  monthlyBudget Float    @default(0)
  currency      String   @default("ILS") // ILS | USD
  metaConversionEvent String @default("") // action_type שנחשב כהמרה (לדוגמה "lead", "purchase", או "offsite_conversion.custom.123")
  clientType    String   @default("לידים")
  status        String   @default("active") // active | at_risk | upsell
  contactEmail  String   @default("")
  contactPhone  String   @default("")
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  // נכסים דיגיטליים
  metaAdAccount   String @default("")
  googleAdAccount String @default("")
  tiktokAdAccount String @default("")
  facebookPage    String @default("")
  instagram       String @default("")
  linkedin        String @default("")
  website         String @default("")
  customAssets    String @default("[]") // JSON array of { id, label, value }

  // ביצועים
  budgetUsed            Float @default(0)
  avgCostPerConversion  Float @default(0)
  targetCostPerConversion Float @default(0)
  conversionsThisMonth  Int   @default(0)
  targetConversions     Int   @default(0)
  lastOptimization      String @default("")

  // קשרים
  managerId     String?
  managerUser   User?          @relation("ClientManager", fields: [managerId], references: [id])
  tasks         Task[]
  optimizations Optimization[]
  leads         Lead[]
  reports       Report[]
  alerts        Alert[]
  chatRoom      ChatRoom?
  platformConnections PlatformConnection[]
  profile       ClientProfile?

  @@map("clients")
}

// ==================== תעודת זהות לקוח ====================

model ClientProfile {
  id        String @id @default(cuid())
  clientId  String @unique
  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // סקשן 1 — פרטי העסק
  businessSector      String @default("") // dropdown value
  businessDescription String @default("") // textarea
  serviceArea         String @default("") // local | national | international
  serviceAreaDetails  String @default("") // ערים/אזורים
  physicalAddress     String @default("")

  // סקשן 2 — מוצרים ושירותים (JSON array)
  products String @default("[]") // [{ name, description, priceRange, pricingModel, seasonality, promotions }]

  // סקשן 3 — USP ומיצוב
  usp                 String @default("") // משפט אחד
  competitiveAdvantage String @default("") // textarea
  whyChooseUs         String @default("") // textarea
  socialProof         String @default("") // textarea
  entryBarriers       String @default("") // textarea
  objections          String @default("") // textarea — כל שורה = התנגדות + תשובה

  // סקשן 4 — קהלי יעד (JSON)
  awarenessLevels String @default("[]") // ["unaware","problem_aware",...]
  audiences       String @default("{}") // { "unaware": { demographics, interests, feelings, keywords, contentTypes, notes }, ... }

  // סקשן 5 — שפה וטון
  marketingLanguages String @default("[]") // ["he","en",...]
  toneOfVoice        String @default("") // dropdown
  forbiddenWords     String @default("") // textarea
  addressStyle       String @default("") // את/אתה/אתם/גוף שלישי

  // סקשן 6 — מתחרים (JSON array)
  competitors String @default("[]") // [{ name, website, facebook, instagram, adLibrary, strengths, weaknesses, notes }]

  // סקשן 7 — נכסים ויזואליים
  brandColors   String @default("[]") // ["#eed89b","#000000",...]
  logoUrl       String @default("")
  adDesignStyle String @default("") // dropdown
  assetBankUrl  String @default("") // Google Drive/Dropbox

  // סקשן 8 — פרטים כספיים (admin only)
  leadSource    String @default("") // dropdown
  lifetimeValue Float  @default(0)
  paymentHistory String @default("[]") // JSON array

  // סקשן 9 — מסמכים (admin only, JSON array)
  documents String @default("[]") // [{ name, type, date, fileUrl }]

  // סקשן 10 — הערות פנימיות (JSON array)
  internalNotes String @default("[]") // [{ content, date, author }]

  updatedAt DateTime @updatedAt

  @@map("client_profiles")
}

model Optimization {
  id              String    @id @default(cuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id])
  date            String
  description     String    @default("") // legacy
  platform        String    @default("") // Meta | Google Ads | TikTok | אתר | אסטרטגיה | קריאייטיב
  campaignIds     String    @default("[]") // JSON array של שמות/IDs של קמפיינים
  actionTaken     String    @default("") // מה ביצענו
  expectedOutcome String    @default("") // מה אנחנו מצפים לקבל
  isChecked       Boolean   @default(false)
  checkedAt       DateTime?
  actualResult    String    @default("") // מה קרה בפועל
  createdAt       DateTime  @default(now())

  @@index([clientId, isChecked])
  @@map("optimizations")
}

// ==================== משימות ====================

model Task {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id])
  assignee    String    @default("")
  assigneeId  String?
  assigneeUser User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creatorId   String?
  creator     User?     @relation("TaskCreator", fields: [creatorId], references: [id])
  priority    String    @default("medium") // low | medium | high | urgent
  dueDate     String    @default("")
  status      String    @default("pending") // pending | in_progress | done
  taskType    String    @default("other") // advertising | other
  platform    String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  notes TaskNote[]

  @@map("tasks")
}

model TaskNote {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  authorName String  @default("")
  content   String
  createdAt DateTime @default(now())

  @@map("task_notes")
}

// ==================== CRM לידים ====================

model Lead {
  id                 String   @id @default(cuid())
  name               String
  email              String   @default("")
  phone              String   @default("")
  company            String   @default("")
  website            String   @default("")
  digitalAssets      String   @default("")
  leadFacebookPage   String   @default("")
  leadInstagram      String   @default("")
  leadLinkedin       String   @default("")
  leadTiktok         String   @default("")
  leadGoogleAds      String   @default("")
  leadMetaAds        String   @default("")
  estimatedBudget    String   @default("")
  salesPerson        String   @default("")
  interestedServices String   @default("[]")
  source             String   @default("other")
  status             String   @default("new")
  stage              String   @default("") // Monday group: לידים נכנסים, פולואפ, נסגרו...
  value              Float    @default(0)
  notes              String   @default("")
  nextFollowUp       String   @default("")
  hasProposal        Boolean  @default(false)
  proposalDate       String   @default("")
  proposalFileName   String   @default("")
  proposalUrl        String   @default("")
  internalNotes      String   @default("")
  quality            String   @default("")
  priority           String   @default("")
  serviceType        String   @default("")
  dealValue          Float    @default(0)
  monthlyValue       Float    @default(0)
  contractSigned     Boolean  @default(false)
  contractUrl        String   @default("")
  proposalSentAt     String   @default("")
  closedAt           String   @default("")
  endDate            String   @default("")
  dealType           String   @default("")
  lifetimeValue      Float    @default(0)
  minMonths          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])
  calls    LeadCall[]

  @@map("leads")
}

model LeadCall {
  id       String   @id @default(cuid())
  leadId   String
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  date     String
  summary  String
  callerId String?
  caller   User?    @relation(fields: [callerId], references: [id])
  callerName String @default("")
  createdAt DateTime @default(now())

  @@map("lead_calls")
}

// ==================== התראות ====================

model Alert {
  id        String   @id @default(cuid())
  type      String   // overdue_task | budget_overrun | performance_drop | upsell_ready | chat_mention | new_task
  title     String
  message   String
  link      String   @default("") // URL לניווט בלחיצה
  isRead    Boolean  @default(false)
  userId    String?  // אם null — לכל המשתמשים; אחרת ספציפי למשתמש
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])
  createdAt DateTime @default(now())

  @@map("alerts")
}

// ==================== דוחות ====================

model Report {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  type        String   // weekly | monthly
  status      String   @default("draft") // draft | generated | sent | failed
  periodStart String
  periodEnd   String
  sentAt      String?
  pdfUrl      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("reports")
}

// Tracker — one row per client with last sent dates (for reports page status tracking)
model ReportTracker {
  clientId        String   @id
  weeklyLastSent  String   @default("") // YYYY-MM-DD
  monthlyLastSent String   @default("") // YYYY-MM-DD
  updatedAt       DateTime @updatedAt

  @@map("report_trackers")
}

// ==================== הגדרות סוכנות ====================

model AgencySettings {
  id                String @id @default("default")
  agencyName        String @default("DigiTailors")
  googleMyBusiness  String @default("")
  facebookPage      String @default("")
  instagram         String @default("")
  linkedin          String @default("")
  metaAdAccount     String @default("")
  googleAdAccount   String @default("")
  tiktokAdAccount   String @default("")
  googleAnalytics   String @default("")
  updatedAt         DateTime @updatedAt

  @@map("agency_settings")
}

// ==================== צ׳אט פנימי ====================

model ChatRoom {
  id        String   @id @default(cuid())
  name      String   @default("") // שם הצ׳אט (אם לא קשור ללקוח)
  clientId  String?  @unique // צ׳אט ללקוח ספציפי (1:1)
  client    Client?  @relation(fields: [clientId], references: [id])
  createdAt DateTime @default(now())

  messages     ChatMessage[]
  participants ChatParticipant[]

  @@map("chat_rooms")
}

model ChatParticipant {
  id       String   @id @default(cuid())
  roomId   String
  room     ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([roomId, userId])
  @@map("chat_participants")
}

model ChatMessage {
  id         String   @id @default(cuid())
  roomId     String
  room       ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id])
  authorName String   @default("")
  content    String
  createdAt  DateTime @default(now())

  readBy     ChatMessageRead[]

  @@map("chat_messages")
}

model ChatMessageRead {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  readAt    DateTime    @default(now())

  @@unique([messageId, userId])
  @@map("chat_message_reads")
}

// ==================== חיבורי פלטפורמות פרסום ====================

// חיבור OAuth ללקוח לפלטפורמה (Meta / Google Ads / TikTok / GA4)
model PlatformConnection {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  platform     String   // "meta" | "google_ads" | "tiktok" | "ga4"
  accessToken  String
  refreshToken String   @default("")
  tokenExpiry  DateTime?
  accountName  String   @default("") // שם המשתמש/חשבון שהתחבר
  accountEmail String   @default("")
  isActive     Boolean  @default(true)
  connectedAt  DateTime @default(now())
  lastSyncAt   DateTime?

  assets PlatformAsset[]

  @@unique([clientId, platform])
  @@map("platform_connections")
}

// נכס ספציפי של חיבור (חשבון מודעות, דף פייסבוק, אינסטגרם וכו')
model PlatformAsset {
  id               String   @id @default(cuid())
  connectionId     String
  connection       PlatformConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  assetType        String   // "ad_account" | "facebook_page" | "instagram" | "google_ads_account" | "ga4_property" | "tiktok_account"
  externalId       String   // ה-ID של הנכס בפלטפורמה החיצונית
  name             String
  isSelected       Boolean  @default(false) // האם הלקוח בחר להשתמש בנכס הזה
  extraData        String   @default("{}") // JSON עם שדות נוספים ספציפיים לפלטפורמה
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([connectionId, assetType, externalId])
  @@map("platform_assets")
}

// ==================== נתוני Meta Ads (Insights) ====================

// שורת insights יומית לכל רמה (account/campaign/adset/ad)
model MetaInsightDaily {
  id           String   @id @default(cuid())
  clientId     String
  assetId      String   // PlatformAsset.id של ה-ad_account
  level        String   // "account" | "campaign" | "adset" | "ad"
  externalId   String   // ה-ID של הישות ב-Meta (campaign_id / adset_id / ad_id / account_id)
  parentId     String   @default("") // ה-ID של ההורה (adset של ad, campaign של adset וכו')
  name         String   @default("")
  status       String   @default("")
  date         String   // YYYY-MM-DD

  spend              Float @default(0)
  impressions        Int   @default(0)
  clicks             Int   @default(0)
  reach              Int   @default(0)
  frequency          Float @default(0)
  ctr                Float @default(0)
  cpc                Float @default(0)
  cpm                Float @default(0)
  conversions        Int   @default(0)
  costPerConversion  Float @default(0)
  purchaseValue      Float @default(0)
  roas               Float @default(0)
  linkClicks         Int   @default(0)
  landingPageViews   Int   @default(0)
  videoViews         Int   @default(0)
  videoThruplay      Int   @default(0)
  engagement         Int   @default(0)
  purchases          Int   @default(0)
  leads              Int   @default(0)
  costPerLead        Float @default(0)
  actionsJson        String @default("{}") // JSON מלא של actions breakdown

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([assetId, level, externalId, date])
  @@index([clientId, date])
  @@index([assetId, date])
  @@map("meta_insight_daily")
}

// פוסט אורגני בעמוד פייסבוק
model MetaPagePost {
  id            String   @id @default(cuid())
  clientId      String
  assetId       String   // PlatformAsset.id של ה-facebook_page
  externalId    String   // post_id
  message       String   @default("")
  permalink     String   @default("")
  mediaType     String   @default("") // photo | video | status | link
  mediaUrl      String   @default("")
  createdTime   DateTime
  reach         Int      @default(0)
  impressions   Int      @default(0)
  engagement    Int      @default(0)
  reactions     Int      @default(0)
  comments      Int      @default(0)
  shares        Int      @default(0)
  clicks        Int      @default(0)
  videoViews    Int      @default(0)
  lastSyncAt    DateTime @default(now())

  @@unique([assetId, externalId])
  @@index([clientId, createdTime])
  @@map("meta_page_posts")
}

// פריט מדיה באינסטגרם (פוסט/ריל/סטורי)
model MetaInstagramMedia {
  id            String   @id @default(cuid())
  clientId      String
  assetId       String   // PlatformAsset.id של ה-instagram
  externalId    String   // media_id
  caption       String   @default("")
  permalink     String   @default("")
  mediaType     String   @default("") // IMAGE | VIDEO | CAROUSEL_ALBUM | REELS
  mediaUrl      String   @default("")
  thumbnailUrl  String   @default("")
  timestamp     DateTime
  reach         Int      @default(0)
  impressions   Int      @default(0)
  likes         Int      @default(0)
  comments      Int      @default(0)
  saves         Int      @default(0)
  shares        Int      @default(0)
  videoViews    Int      @default(0)
  profileVisits Int      @default(0)
  lastSyncAt    DateTime @default(now())

  @@unique([assetId, externalId])
  @@index([clientId, timestamp])
  @@map("meta_instagram_media")
}

// ==================== הודעות ותגובות (cache מקומי) ====================

// שיחת Messenger בעמוד פייסבוק
model FbConversationCache {
  id              String   @id @default(cuid())
  clientId        String
  pageId          String
  externalId      String   // Meta conversation id
  participantName String   @default("")
  participantPsid String   @default("") // PSID של המשתמש (לא העמוד)
  snippet         String   @default("")
  messageCount    Int      @default(0)
  updatedTime     DateTime?
  messagesJson    String   @default("[]") // JSON של הודעות
  lastSyncAt      DateTime @default(now())

  @@unique([clientId, externalId])
  @@index([clientId, updatedTime])
  @@map("fb_conversation_cache")
}

// תגובה על פוסט פייסבוק
model FbCommentCache {
  id            String    @id @default(cuid())
  clientId      String
  pageId        String
  externalId    String    // Comment id
  postId        String    @default("")
  postMessage   String    @default("")
  postPermalink String    @default("")
  message       String    @default("")
  fromName      String    @default("")
  fromId        String    @default("")
  createdTime   DateTime?
  likeCount     Int       @default(0)
  commentCount  Int       @default(0)
  permalinkUrl  String    @default("")
  repliesJson   String    @default("[]") // JSON
  lastSyncAt    DateTime  @default(now())

  @@unique([clientId, externalId])
  @@index([clientId, createdTime])
  @@map("fb_comment_cache")
}

// תגובה באינסטגרם
model IgCommentCache {
  id           String    @id @default(cuid())
  clientId     String
  igAccountId  String
  externalId   String    // Comment id
  mediaId      String    @default("")
  mediaCaption String    @default("")
  text         String    @default("")
  fromUsername String    @default("")
  fromId       String    @default("")
  timestamp    DateTime?
  likeCount    Int       @default(0)
  repliesJson  String    @default("[]")
  lastSyncAt   DateTime  @default(now())

  @@unique([clientId, externalId])
  @@index([clientId, timestamp])
  @@map("ig_comment_cache")
}

// סטטוס סנכרון לכל סוג של הודעות לכל לקוח
model MessageSyncStatus {
  id         String    @id @default(cuid())
  clientId   String
  type       String    // "fb_messages" | "fb_comments" | "ig_comments"
  lastSyncAt DateTime?
  recordCount Int      @default(0)
  errorMsg   String    @default("")

  @@unique([clientId, type])
  @@map("message_sync_status")
}

// לוג סנכרון — תיעוד כל ריצה של שליפת נתונים
model SyncLog {
  id             String   @id @default(cuid())
  platform       String   // "meta" | "google_ads" | "tiktok" | "ga4"
  clientId       String   @default("")
  connectionId   String   @default("")
  assetId        String   @default("")
  syncType       String   // "ad_insights" | "page_posts" | "instagram_media" | "assets_discovery"
  status         String   // "success" | "partial" | "error"
  errorMessage   String   @default("")
  recordsFetched Int      @default(0)
  durationMs     Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([platform, createdAt])
  @@index([clientId, createdAt])
  @@map("sync_logs")
}

// ==================== Google Calendar ====================

model GoogleCalendarConnection {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String    @default("")
  tokenExpiry  DateTime?
  email        String    @default("")
  connectedAt  DateTime  @default(now())

  @@map("google_calendar_connections")
}

// ==================== AI Chat ====================

model AiChat {
  id        String   @id @default(cuid())
  clientId  String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String   @default("שיחה חדשה")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AiChatMessage[]

  @@index([clientId, userId])
  @@map("ai_chats")
}

model AiChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  chat      AiChat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  role      String   // "user" | "assistant" | "system"
  content   String
  createdAt DateTime @default(now())

  @@map("ai_chat_messages")
}

// ==================== גיוסים ====================

model Recruitment {
  id         String   @id @default(cuid())
  name       String
  email      String   @default("")
  phone      String   @default("")
  experience String   @default("")
  notes      String   @default("")
  cvUrl      String   @default("")
  stage      String   @default("submitted") // submitted | task_sent | interview | accepted | rejected
  position   String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("recruitments")
}

// ==================== ספקים ====================

model Supplier {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("") // ספק | שותף | פרילנסר
  field     String   @default("") // בניית אתרים | עיצוב | ...
  phone     String   @default("")
  role      String   @default("")
  company   String   @default("")
  email     String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("suppliers")
}
