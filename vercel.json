{
  "crons": [
    {
      "path": "/api/cron/sync-all",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/sync-stale",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/detect",
      "schedule": "20 5 * * *"
    },
    {
      "path": "/api/cron/weekly-reports",
      "schedule": "0 4 * * 0"
    },
    {
      "path": "/api/cron/overdue-tasks?mode=telegram",
      "schedule": "0 15 * * 4"
    },
    {
      "path": "/api/cron/overdue-tasks?mode=email",
      "schedule": "30 5 * * 0"
    }
  ]
}
